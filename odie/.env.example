# Same Supabase project Piton's mobile app uses (vqsxctinikqphurhoael) —
# Odie is an operations layer on the same backend, not a separate one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Powers the command router (Claude tool-use loop).
ANTHROPIC_API_KEY=

# Restricts Odie access to a single owner account. Must match a real
# Supabase auth user's email in the same project.
ODIE_OWNER_EMAIL=tommy.odell1029@gmail.com

# Optional. A GitHub PAT (repo + workflow scopes) letting Odie dispatch
# agents/.github/workflows/agents-weekly.yml on demand. Until this is set,
# the "run an agent now" command clearly reports itself as not configured
# instead of silently doing nothing.
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_OWNER=tommyodell1029
GITHUB_DISPATCH_REPO=piton
GITHUB_DISPATCH_REF=main
